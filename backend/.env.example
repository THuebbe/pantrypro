SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
PORT=3001

# Encrypts POS credentials (Toast client secrets etc.) before they are stored.
# Required before any restaurant can connect a POS. 32 bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and do not change it once restaurants are connected.
POS_CREDENTIALS_KEY=

# Optional: how often to pull sales from connected POS systems (default 5)
# POS_SYNC_INTERVAL_MINUTES=5
# Optional: set to false to stop this instance from running the sales sync
# POS_SYNC_ENABLED=true
