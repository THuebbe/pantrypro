SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
PORT=3001

# Encrypts POS credentials (Toast client secrets etc.) before they are stored.
# Required before any restaurant can connect a POS. 32 bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and do not change it once restaurants are connected.
POS_CREDENTIALS_KEY=

# Optional: how often to pull sales from connected POS systems (default 5)
# POS_SYNC_INTERVAL_MINUTES=5
# Optional: set to false to stop this instance from running the sales sync
# POS_SYNC_ENABLED=true

# Recipe drafts ("Draft with AI" on the Recipe Builder). Create a key at
# https://console.anthropic.com and set it on the backend host only.
ANTHROPIC_API_KEY=
# Optional: which Claude model drafts recipes (default claude-haiku-5-5)
# RECIPE_DRAFT_MODEL=claude-haiku-5-5

# Billing (Stripe). Leave all of these unset until Stripe is ready: the app
# then runs with billing off and everyone has full access.
# 1. Run database/migrations/20261116_business_billing.sql
# 2. In Stripe, create the monthly price and copy its id (price_...)
# 3. In Stripe, add a webhook endpoint for
#      https://<backend-host>/api/billing/webhook
#    with events: checkout.session.completed, customer.subscription.created,
#    customer.subscription.updated, customer.subscription.deleted, invoice.paid
#    and copy its signing secret (whsec_...)
# 4. Set the three values below. Subscribing now works but nothing is locked.
# 5. Set BILLING_ENFORCED=true to make unsubscribed accounts read-only.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# BILLING_ENFORCED=true
# Where Stripe sends customers back to (the site's address)
# FRONTEND_URL=https://pantrypro-six.vercel.app
